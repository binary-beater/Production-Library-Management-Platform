PROJECT_NAME="Library Management Platform"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
MYSQL_SERVER="db"
MYSQL_PORT=3306
MYSQL_USER="lmp_user"
MYSQL_PASSWORD="lmp_password"
MYSQL_DB="lmp_db"

# JWT Security
SECRET_KEY="supersecretproductiongradejwtsecretkeychangeinproduction"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Business Rules Constants
MAX_BORROW_LIMIT=5
DEFAULT_BORROW_DAYS=14
MAX_RENEWAL_LIMIT=2

# Observability
LOG_LEVEL="INFO"
